* {
    primary:                    {{ color2 }};
    primary-fixed:              {{ color2 | lighten(0.3) }};
    primary-fixed-dim:          {{ color5 }};
    on-primary:                 {{ background }};
    on-primary-fixed:           {{ foreground }};
    on-primary-fixed-variant:   {{ color8 }};
    primary-container:          {{ color2 | lighten(0.2) }};
    on-primary-container:       {{ background }};
    secondary:                  {{ color3 }};
    secondary-fixed:            {{ color3 | lighten(0.3) }};
    secondary-fixed-dim:        {{ color6 }};
    on-secondary:               {{ background }};
    on-secondary-fixed:         {{ foreground }};
    on-secondary-fixed-variant: {{ color8 }};
    secondary-container:        {{ color3 | lighten(0.2) }};
    on-secondary-container:     {{ background }};
    tertiary:                   {{ color4 }};
    tertiary-fixed:             {{ color4 | lighten(0.3) }};
    tertiary-fixed-dim:         {{ color4 | darken(0.2) }};
    on-tertiary:                {{ background }};
    on-tertiary-fixed:          {{ foreground }};
    on-tertiary-fixed-variant:  {{ color8 }};
    tertiary-container:         {{ color4 | lighten(0.2) }};
    on-tertiary-container:      {{ background }};
    error:                      {{ color1 }};
    on-error:                   {{ background }};
    error-container:            {{ color1 | lighten(0.2) }};
    on-error-container:         {{ background }};
    surface:                    {{ background }};
    on-surface:                 {{ foreground }};
    on-surface-variant:         {{ foreground | darken(0.2) }};
    outline:                    {{ color8 }};
    outline-variant:            {{ color8 | darken(0.2) }};
    shadow:                     {{ background | darken(0.2) }};
    scrim:                      {{ background }};
    inverse-surface:            {{ foreground }};
    inverse-on-surface:         {{ background }};
    inverse-primary:            {{ color2 | lighten(0.3) }};
    surface-dim:                {{ background | darken(0.05) }};
    surface-bright:             {{ background | lighten(0.2) }};
    surface-container-lowest:   {{ background | darken(0.15) }};
    surface-container-low:      {{ background | darken(0.08) }};
    surface-container:          {{ background | lighten(0.05) }};
    surface-container-high:     {{ background | lighten(0.1) }};
    surface-container-highest:  {{ background | lighten(0.15) }};
}